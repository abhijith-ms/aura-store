#!/bin/bash
# Standalone Desktop Launcher for Aura Store
set -e

# Resolve the real script location (BASH_SOURCE isn't symlink-aware, and
# this script is commonly invoked via a ~/.local/bin/aura-store symlink).
REAL_SCRIPT="$(readlink -f "${BASH_SOURCE[0]}")"
REPO_DIR="$(cd "$(dirname "${REAL_SCRIPT}")/.." && pwd)"

# A repo checkout keeps dist/server/electron as siblings of bin/'s parent.
# A PKGBUILD install copies this script to /usr/bin, separate from the app
# data in /usr/lib/aura-store, so fall back to that layout when neither
# dist/ nor server/ exist next to the script.
if [ -d "${REPO_DIR}/dist" ] || [ -f "${REPO_DIR}/server/index.js" ]; then
  DIR="${REPO_DIR}"
elif [ -d "/usr/lib/aura-store" ]; then
  DIR="/usr/lib/aura-store"
else
  echo "Error: could not locate the Aura Store application directory" >&2
  exit 1
fi

PORT=3001
HOST="http://localhost:${PORT}"
USER_DATA_DIR="${HOME}/.config/aura/app-profile"

# 1. Build dist bundle if not already present
if [ ! -d "${DIR}/dist" ]; then
  echo "Building Aura Store frontend..."
  (cd "${DIR}" && npm run build >/dev/null 2>&1)
fi

# 2. Handle optional action view flags
VIEW_PARAM=""
if [[ "$*" == *"--view=updates"* ]]; then
  VIEW_PARAM="?view=updates"
elif [[ "$*" == *"--view=explore"* ]]; then
  VIEW_PARAM="?view=explore"
fi

# 3. Prefer a real native window via system Electron (Arch ships
# versioned electronNN packages; the plain "electron" binary only
# exists if the meta-package is installed).
ELECTRON_BIN="$(command -v electron || compgen -c electron 2>/dev/null | grep -E '^electron[0-9]+$' | sort -rV | head -1)"
if [ -n "${ELECTRON_BIN}" ]; then
  exec env AURA_VIEW="${VIEW_PARAM}" "${ELECTRON_BIN}" "${DIR}/electron/main.js" --class=aura-store
fi

# 4. Fallback: start unified server in background if not already listening,
# then open it in an installed browser's isolated --app window.
if ! ss -tulpn 2>/dev/null | grep -q ":${PORT}"; then
  (cd "${DIR}" && node server/index.js >/dev/null 2>&1) &
  sleep 0.8
fi

TARGET_URL="${HOST}${VIEW_PARAM}"

# 5. Launch dedicated isolated frameless desktop window
if command -v brave >/dev/null 2>&1; then
  exec brave --app="${TARGET_URL}" --user-data-dir="${USER_DATA_DIR}" --class="aura-store" --name="Aura Store" "$@"
elif command -v google-chrome-stable >/dev/null 2>&1; then
  exec google-chrome-stable --app="${TARGET_URL}" --user-data-dir="${USER_DATA_DIR}" --class="aura-store" --name="Aura Store" "$@"
elif command -v chromium >/dev/null 2>&1; then
  exec chromium --app="${TARGET_URL}" --user-data-dir="${USER_DATA_DIR}" --class="aura-store" --name="Aura Store" "$@"
elif command -v vivaldi >/dev/null 2>&1; then
  exec vivaldi --app="${TARGET_URL}" --user-data-dir="${USER_DATA_DIR}" --class="aura-store" --name="Aura Store" "$@"
elif command -v zen-browser >/dev/null 2>&1; then
  exec zen-browser --new-window "${TARGET_URL}"
elif command -v firefox >/dev/null 2>&1; then
  exec firefox --new-window "${TARGET_URL}"
else
  exec xdg-open "${TARGET_URL}"
fi
